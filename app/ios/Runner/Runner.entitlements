<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Shared with the share extension (ShareExtension/), which hands shared
	     photos/videos over to the app through this group's container. -->
	<!-- Communication Notifications: message notifications show the
	     sender's profile picture (NotificationServiceExtension/SenderAvatar). -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.me.holzeis.roost.roost</string>
	</array>
</dict>
</plist>
