<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Roost</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>roost</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Roost needs access to your photo library to share photos and videos in chat.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Roost needs permission to save photos and videos from chat to your photo library.</string>
	<key>NSCameraUsageDescription</key>
	<string>Roost needs access to your camera to share photos and video in chat and calls.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Roost needs access to your microphone for voice and video calls.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Roost uses your location to share it with people in a chat, for as long as you choose to share it.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Roost uses your location to keep sharing it with people in a chat while the app is in the background, for as long as you choose to share it.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<!-- FR5.1: voip wakes the app for PushKit/CallKit incoming calls;
		     remote-notification is required alongside it per Apple's own
		     PushKit docs, even though this app sends no plain remote pushes
		     today. See ios/Runner/AppDelegate.swift. -->
		<string>voip</string>
		<string>remote-notification</string>
	</array>
	<key>GMSApiKey</key>
	<string>$(GOOGLE_MAPS_API_KEY)</string>
	<!-- Declares export-compliance status once, up front, instead of
	     answering Apple's encryption questionnaire on every single
	     TestFlight build. Roost only uses standard, exempt encryption —
	     TLS/HTTPS via iOS's own system libraries (APNs, FCM, link
	     previews) and Tailscale's WireGuard, both publicly available,
	     standard algorithms — never a custom/proprietary cipher. That
	     also means the France-specific cryptography declaration Apple
	     sometimes asks about doesn't apply here: it's only triggered by
	     non-exempt encryption, which this isn't. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- TEMPORARY, remove once flutter/flutter#179482 is fixed upstream
	     (tracked fix: flutter/flutter PR #186365, unmerged as of writing).
	     iOS 26's Liquid Glass keyboard is translucent/rounded; Flutter's
	     Scaffold paints its background assuming an opaque keyboard, so a
	     persistent bar sitting directly above the keyboard (our message
	     composer) shows a color seam at the keyboard's rounded corners no
	     app-level color/layout change can fix — see chat_screen.dart's
	     Scaffold body comment and RoostColors.lightSurface0/darkSurface0
	     for the (correct, keep-in-place) composer/keyboard color match
	     this sits on top of. Setting this reverts the WHOLE app's native
	     chrome (nav bars, tab bars, sheets, keyboard) to the pre-iOS-26
	     design, which also eliminates this seam as a side effect. Apple
	     has stated this key is a temporary compatibility aid, expected to
	     stop working around iOS 27 — this is not a permanent fix, and
	     should be removed (not just left in place) once the Flutter fix
	     ships, to pick back up Liquid Glass's actual intended look. -->
	<key>UIDesignRequiresCompatibility</key>
	<true/>
</dict>
</plist>
