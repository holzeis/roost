# Copy to .env and fill in real values. Never commit the real .env file.

# Postgres
POSTGRES_PASSWORD=change-me

# S3-compatible object storage (SeaweedFS — see docker-compose.yml's own
# comment for why this isn't MinIO anymore). Configures both the storage
# container's one admin identity and chat-server's own S3 client.
S3_ACCESS_KEY=roost
S3_SECRET_KEY=change-me

# LiveKit (dev keys are fine for local docker-compose; generate real ones for
# any tailnet/production deployment — see docs/architecture-overview.md)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-devsecret-devsecret

# Push notifications (APNs/FCM) — see docs/architecture-overview.md's call
# flow for why these are the one external dependency. Leave unset for local
# dev; the server falls back to a no-op push sender (internal/push).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
FCM_SERVICE_ACCOUNT_JSON=

# Static map snapshot for an ended location share (FR3.7, internal/staticmap)
# — a Google Cloud API key with the Maps Static API enabled, restricted by
# IP address rather than Android/iOS app restriction (this is a server-side
# call, not the client SDK). Leave unset for local dev; ended shares just
# won't get a snapshot.
GOOGLE_MAPS_STATIC_API_KEY=
